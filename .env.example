# ===================================================
# Barron Production Management System
# Environment Configuration Template
# ===================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (not committed to git)
# 2. Update all values with your production credentials
# 3. Never commit .env file to version control
# 4. Keep this file secure (chmod 600 .env)
# 
# ===================================================

# ===================================================
# APPLICATION SETTINGS
# ===================================================

APP_NAME="Barron Production Management System"
APP_VERSION="1.1"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
BASE_PATH=/var/www/barron-production

# ===================================================
# DATABASE CONFIGURATION
# ===================================================

DB_CONNECTION=mysql
DB_HOST=yamanote.proxy.rlwy.net
DB_PORT=39713
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=hwemqHyJCOMkVycHiOcRqWBXnUryhFjw
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===================================================
# REDIS CONFIGURATION
# ===================================================

REDIS_HOST=caboose.proxy.rlwy.net
REDIS_PORT=39766
REDIS_PASSWORD=maXFCPazHpxaASnHpDcszQQpTsfONXFE
REDIS_DATABASE=0
REDIS_PREFIX=barron_

# Session Settings
SESSION_DRIVER=redis
SESSION_LIFETIME=1800
SESSION_COOKIE_NAME=barron_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ===================================================
# SECURITY SETTINGS
# ===================================================

# Password Hashing
PASSWORD_BCRYPT_COST=12

# CSRF Protection
CSRF_ENABLED=true
CSRF_TOKEN_NAME=csrf_token

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1

# Failed Login Tracking
TRACK_FAILED_LOGINS=true
MAX_FAILED_LOGINS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

# ===================================================
# LOGGING
# ===================================================

LOG_LEVEL=warning
LOG_CHANNEL=daily
LOG_PATH=/var/log/barron-production
LOG_FILE=app.log
LOG_MAX_FILES=30

# Error Logging
ERROR_LOG_ENABLED=true
ERROR_LOG_PATH=/var/log/barron-production/error.log

# Activity Logging
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_RETENTION_DAYS=90

# ===================================================
# MAIL CONFIGURATION (Optional)
# ===================================================

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@barron.com
MAIL_FROM_NAME="Barron Production System"

# Admin Alert Email
ADMIN_EMAIL=admin@barron.com
ALERT_EMAIL_ENABLED=false

# ===================================================
# FILE UPLOAD SETTINGS
# ===================================================

UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx
UPLOAD_PATH=/var/www/barron-production/uploads

# ===================================================
# BACKUP SETTINGS
# ===================================================

BACKUP_ENABLED=true
BACKUP_PATH=/backups/barron-production
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=02:00

# ===================================================
# PERFORMANCE SETTINGS
# ===================================================

# Caching
CACHE_DRIVER=redis
CACHE_PREFIX=barron_cache_
CACHE_DEFAULT_TTL=3600

# Query Caching
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300

# Static Asset Caching
ASSET_CACHE_ENABLED=true
ASSET_CACHE_TTL=2592000

# ===================================================
# TIMEZONE & LOCALE
# ===================================================

APP_TIMEZONE=Africa/Johannesburg
APP_LOCALE=en_ZA
APP_CURRENCY=ZAR
APP_DATE_FORMAT=d/m/Y
APP_TIME_FORMAT=H:i
APP_DATETIME_FORMAT=d/m/Y H:i

# ===================================================
# API SETTINGS
# ===================================================

API_RATE_LIMIT=100
API_RATE_LIMIT_PERIOD=60
API_TIMEOUT=30

# ===================================================
# MONITORING & ALERTS
# ===================================================

MONITORING_ENABLED=true
HEALTH_CHECK_URL=/health
HEALTH_CHECK_INTERVAL=300

# Disk Space Alert
DISK_SPACE_ALERT_THRESHOLD=90
DISK_SPACE_CHECK_INTERVAL=3600

# Memory Alert
MEMORY_ALERT_THRESHOLD=85
MEMORY_CHECK_INTERVAL=300

# ===================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ===================================================

# SMS Gateway
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=

# Payment Gateway
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# ===================================================
# FEATURE FLAGS
# ===================================================

FEATURE_FINANCE_MODULE=true
FEATURE_REPORTS_MODULE=false
FEATURE_INVENTORY_MODULE=false
FEATURE_SUPPLIER_MODULE=false

# ===================================================
# MAINTENANCE MODE
# ===================================================

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# ===================================================
# DEVELOPMENT/STAGING SPECIFIC
# ===================================================
# (Comment out or remove in production)

# DEV_MODE=true
# SHOW_ERRORS=true
# DEBUG_QUERIES=true
# FAKE_EMAIL=true

# ===================================================
# NOTES
# ===================================================
# 
# - Keep this file secure and never commit to git
# - Use strong, unique passwords for all services
# - Enable HTTPS in production (SESSION_COOKIE_SECURE=true)
# - Set appropriate file permissions: chmod 600 .env
# - Review and adjust settings based on your infrastructure
# - Test in staging before deploying to production
# 
# ===================================================
